# ==========================================
# MakeAWish Root Environment Variables Template
# ==========================================

# Server Port
PORT=3001

# Supabase Managed Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Cloudinary Media Storage (Photos & Videos)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# JWT Secret (36-hour session tokens)
JWT_SECRET=your-long-random-jwt-secret-string

# Transactional Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=MakeAWish <verify@yourdomain.com>

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public URLs for Keep-Alive Pings
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:80
